<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:type="radial"
                android:gradientRadius="40dp"
                android:centerColor="#6478FF"
                android:startColor="#6478FF"
                android:endColor="@color/brand_primary" />
            <stroke
                android:width="2dp"
                android:color="#59FFFFFF" />
        </shape>
    </item>
    <item
        android:top="8dp"
        android:start="10dp"
        android:end="32dp"
        android:bottom="34dp">
        <shape android:shape="oval">
            <solid android:color="#3DFFFFFF" />
        </shape>
    </item>
</layer-list>
